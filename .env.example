# Copie para .env e ajuste. Valores abaixo são apenas DEMONSTRATIVOS.
DJANGO_SECRET_KEY=troque-por-uma-chave-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Em produção, informe as origens HTTPS confiáveis para CSRF:
# DJANGO_CSRF_TRUSTED_ORIGINS=https://ruasbrasil.example.org

# Banco: "postgresql" (padrão) ou "sqlite" (somente demonstração local)
DJANGO_DB_ENGINE=postgresql
POSTGRES_DB=ruas_brasil
POSTGRES_USER=ruas_brasil
POSTGRES_PASSWORD=senha-de-desenvolvimento-local
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Uploads privados (fora de qualquer pasta pública)
# DJANGO_PRIVATE_MEDIA_ROOT=/var/lib/ruas-brasil/private_media

# Número de proxies reversos confiáveis à frente da aplicação.
# 0 = ignora X-Forwarded-For (padrão seguro). Use 1 atrás de um único Nginx.
DJANGO_TRUSTED_PROXY_COUNT=0
